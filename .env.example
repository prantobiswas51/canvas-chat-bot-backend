FB_APP_SECRET=
FB_APP_ID=
FB_PAGE_ACCESS_TOKEN=
FB_VERIFY_TOKEN=

PORT=3001
FRONTEND_ORIGIN=http://localhost:3000

# Postgres (runs in docker-compose; backend connects from host via localhost)
POSTGRES_USER=canvas
POSTGRES_PASSWORD=canvas
POSTGRES_DB=canvas_chat_bot
POSTGRES_PORT=5532
POSTGRES_HOST=localhost
DATABASE_URL=postgresql://canvas:canvas@localhost:5532/canvas_chat_bot

# Auth
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# WhatsApp Cloud API (Meta) — from your Meta App's WhatsApp product
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_GRAPH_API_VERSION=v21.0
WA_DISPLAY_NAME=Canvas Art Supplies WhatsApp

# Redis — backs the ai-reply queue (runs in docker-compose alongside postgres)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Max AI replies generated at the same time. Inbound messages beyond this
# wait in the Redis queue instead of all hitting the AI provider at once —
# raise this once you know your provider's actual RPM ceiling, lower it if
# you're still hitting 429s.
AI_WORKER_CONCURRENCY=3

# How long (ms) to wait after a customer's last message before actually
# calling Gemini — collapses a burst of separate messages ("how are" / "you")
# into one AI call instead of replying to each half-thought separately.
# Every new message from the same customer resets this timer.
AI_REPLY_DEBOUNCE_MS=25000

# GEMINI_MODEL is tried first; on a 429/503/5xx this comma-separated list is
# tried next, in order, within the same job attempt, before the job itself
# is retried. Leave unset to use the built-in default
# (gemini-2.5-flash,gemini-2.0-flash,gemini-flash-latest).
GEMINI_FALLBACK_MODELS=

# OpenAI — selectable as an alternate AI provider from Settings → AI
# Instructions (Gemini stays the default). No model-fallback chain like
# Gemini has yet — a transient 429/5xx just relies on the BullMQ job retry.
CHATGPT_API_KEY=
OPENAI_MODEL=gpt-4o-mini

